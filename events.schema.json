{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Events list",
  "type": "array",
  "items": {
    "$ref": "#/definitions/event"
  },
  "definitions": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier; never change after publishing.",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "workshop",
            "meetup",
            "test"
          ]
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string"
        },
        "maps_url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
